CREATE TABLE hobby (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100)
);

CREATE TABLE employee (
    id INT PRIMARY KEY AUTO_INCREMENT,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    age INT,
    mobile_number VARCHAR(15),
    address VARCHAR(255)
);

CREATE TABLE employee_salary (
    id INT PRIMARY KEY AUTO_INCREMENT,
    employee_id INT,
    salary DECIMAL(10,2),
    salary_date DATE,
    
    FOREIGN KEY (employee_id)
    REFERENCES employee(id)
);

CREATE TABLE employee_salary (
    id INT PRIMARY KEY AUTO_INCREMENT,
    employee_id INT,
    salary DECIMAL(10,2),
    salary_date DATE,
    
    FOREIGN KEY (employee_id)
    REFERENCES employee(id)
);

