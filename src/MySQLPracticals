    CONCAT(e.first_name, ' ', e.last_name) AS employee_name,

    (
        SELECT SUM(es.salary)
        FROM employee_salary es
        WHERE es.employee_id = e.id
    ) AS total_salary,

    (
        SELECT GROUP_CONCAT(h.name SEPARATOR ', ')
        FROM employee_hobby eh
        INNER JOIN hobby h
            ON eh.hobby_id = h.id
        WHERE eh.employee_id = e.id
    ) AS hobbies

